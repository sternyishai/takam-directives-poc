{
  "name": "@takam/ingest",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "ingest",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/ingest/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/ingest/src/main.ts",
          "tsConfig": "apps/ingest/tsconfig.app.json",
          "assets": [
            "apps/ingest/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/ingest/dist/package.json",
          "{workspaceRoot}/apps/ingest/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/ingest/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@takam/shared": "*",
    "@takam/store": "*",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "@takam/sanitize": "*",
    "@takam/llm": "*"
  }
}

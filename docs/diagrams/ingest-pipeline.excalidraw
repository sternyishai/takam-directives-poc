   "opacity": 100,
   "originalText": "Steps 1–2 call takam.mof.gov.il: api/Document, api/DocumentVersion\nand api/DocumentSF/DownloadDocument (the site's own JSON API).\nRaw files are kept in data/raw/ (gitignored, never served).\nThe API sanitizes the HTML again before it sends it.",
   "roughness": 0,
   "roundness": null,
   "seed": 175593967,
   "strokeColor": "#616161",
   "strokeStyle": "solid",
   "strokeWidth": 2,
   "text": "Steps 1–2 call takam.mof.gov.il: api/Document, api/DocumentVersion\nand api/DocumentSF/DownloadDocument (the site's own JSON API).\nRaw files are kept in data/raw/ (gitignored, never served).\nThe API sanitizes the HTML again before it sends it.",
   "textAlign": "left",
   "updated": 1795480351322,
   "version": 1,
   "versionNonce": 1003952697,
   "verticalAlign": "top"
  },

# Copy this file to .env and fill in your own key. .env is gitignored.
# A key from https://aistudio.google.com/apikey. Search and the viewer work without it.
GOOGLE_API_KEY=
# The Gemini chat model (enrichment and chat). Checked against the key in milestone 6.
LLM_MODEL=gemini-3.6-flash
# The Gemini embedding model (chunk and question embeddings).
EMBEDDING_MODEL=gemini-embedding-001
